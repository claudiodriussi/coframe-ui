# Optional local overrides — copy to .env.<app-instance> (e.g. .env.demo) or to
# .env.development / .env.production. None of this is required: the client
# derives prefix, endpoint prefix and API port from the backend config.yaml of
# the app it is bound to (see kitebase.config.js and ../../apps.config.js), and
# its dev port from kitebase.config.js.
#
# Two layers, the app-specific one wins:
#   .env.development / .env.production   shared by every app-instance
#   .env.<app-instance>                  one backend only
#
# Which app-instance a client is bound to is decided by kitebase.config.js.
# Only apps/shell accepts an override:
#   KITEBASE_APP=<name> pnpm --filter shell dev             an app of this workspace
#   KITEBASE_APP_ROOT=/path/to/app pnpm --filter shell dev  an app anywhere else

# Backend API base URL. Dev: full URL of the backend dev server.
# Prod: leave empty (same origin — the app's own server serves both).
VITE_API_BASE_URL=

# API route prefix (backend config.yaml → api.prefix).
VITE_API_PREFIX=kitebase

# Dispatcher prefix (backend config.yaml → api.endpoint_prefix).
VITE_API_ENDPOINT_PREFIX=endpoint

# Frontend dev server port.
VITE_DEV_PORT=
