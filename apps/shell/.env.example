# Copy to .env.development and .env.production and adjust values.

# Backend API base URL.
# Dev: full URL of the backend dev server.
# Prod: leave empty (same origin - FastAPI serves both frontend and API).
VITE_API_BASE_URL=http://localhost:8300

# API route prefix (must match config.yaml → api.prefix on the backend).
VITE_API_PREFIX=coframe

# Frontend dev server port.
VITE_DEV_PORT=5173
