# Copy to .env.development and .env.production and adjust values.
#
# The shell is bound to one project at a time, so a project gets its own
# .env.<project> and is started with the matching mode:
#
#   COFRAME_APP=demo pnpm --filter shell dev --mode demo
#
# COFRAME_APP picks the backend plugins directory ($plugins, see
# coframe.config.js), --mode picks this file. Keep the two names equal: a
# client pointed at the wrong backend does not fail, it just talks to the
# wrong database. Ports in use: devtest 8300/5173, artmob 8301/5174,
# demo 8302/5175.

# Backend API base URL.
# Dev: full URL of the backend dev server.
# Prod: leave empty (same origin - FastAPI serves both frontend and API).
VITE_API_BASE_URL=http://localhost:8300

# API route prefix (must match config.yaml → api.prefix on the backend).
VITE_API_PREFIX=coframe

# Frontend dev server port.
VITE_DEV_PORT=5173
